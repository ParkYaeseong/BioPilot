        "atlas_prediction",
        "atlas_sequence",
        "esm_score",
        "dataset_metadata",
        "execution_event",
        "synthetic_fixture",
        "pdb_reference_structure",
        "sequence_mapping",
        "assay_definition"
      ]
    },
    "source_uri": {
      "type": "string"
    },
    "source_version": {
