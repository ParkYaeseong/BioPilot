# Local-only template. Never commit the real .env.
META_API_KEY=
# MODEL_API_KEY is also accepted by the controlled Meta client.

# Selection grants no execution permission. Modal is the requested default.
ESM_BACKEND=modal
ESM_MODEL_KEY=esm150
ESM_DEVICE=cpu
ESM_LOCAL_CHECKPOINT_DIR=
ESM_WEIGHTS_SHA256=
ESM_TOKENIZER_SHA256=
ESM_PROVIDER_BINDING=

# Keep blocked until the exact GPU, download, deployment and spend are approved.
ESM_REMOTE_EXECUTION_APPROVED=false
ESM_REMOTE_ESTIMATE_MICROS=0
# Scientific jobs reserve the whole 900-second supported worker ceiling until
# an actual deployed timeout attestation is available; a shorter client wait
# does not reduce this conservative reservation.
ESM_REMOTE_TIMEOUT_SECONDS=900
MODAL_APP_NAME=
MODAL_FUNCTION_NAME=
MODAL_ENVIRONMENT=
MODAL_SDK_VERSION=1.6.2
MODAL_COMPATIBILITY_VERIFIED=false

# Modal authentication belongs to the Modal client only. Never forward these or
# META_API_KEY to an ESM function payload or use Secret.from_dotenv().
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
